[Unit]
Description=Stanok monitor Cloudflare tunnel (faqat ko'rish, login bilan)
After=network-online.target stanok-web.service
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8091
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
